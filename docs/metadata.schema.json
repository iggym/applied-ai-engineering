{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applied AI Engineering Metadata Schema",
  "description": "Schema for article metadata in the Applied AI Engineering hub",
  "type": "object",
  "required": ["site", "articles"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["repo_name", "title", "tagline", "base_url", "audience", "description"],
      "properties": {
        "repo_name": {
          "type": "string",
          "description": "Repository name"
        },
        "title": {
          "type": "string",
          "description": "Site title"
        },
        "tagline": {
          "type": "string",
          "description": "Site tagline"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL for the site"
        },
        "audience": {
          "type": "string",
          "description": "Target audience"
        },
        "description": {
          "type": "string",
          "description": "Site description"
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "hook", "path", "date", "status", "format", "tags", "reading_time_minutes", "pinned", "research_window"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{3}$",
            "description": "3-digit article ID in docket order (001-999)"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "URL-safe slug (lowercase, hyphens only)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Article title"
          },
          "hook": {
            "type": "string",
            "minLength": 1,
            "description": "Brief hook/subtitle (1-2 sentences)"
          },
          "path": {
            "type": "string",
            "pattern": "^articles/[a-z0-9-]+\\.html$",
            "description": "Path to HTML file in articles/ directory"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Publication date (YYYY-MM-DD)"
          },
          "status": {
            "type": "string",
            "enum": ["published", "draft", "archived"],
            "description": "Publication status"
          },
          "format": {
            "type": "string",
            "enum": ["essay", "guide", "analysis", "tutorial"],
            "description": "Article format"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "description": "Content tags (lowercase, hyphens)"
          },
          "reading_time_minutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Estimated reading time in minutes"
          },
          "pinned": {
            "type": "boolean",
            "description": "Whether article is pinned to top of hub"
          },
          "research_window": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} to \\d{4}-\\d{2}-\\d{2}$",
            "description": "Research period (YYYY-MM-DD to YYYY-MM-DD)"
          }
        }
      }
    }
  }
}
